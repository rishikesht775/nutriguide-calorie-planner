{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "test:all": "playwright test",
    "test:backend": "npm run test:contracts && playwright test tests/e2e/backend.spec.ts tests/e2e/database.spec.ts",
    "test:security": "playwright test tests/e2e/auth.spec.ts tests/e2e/security.spec.ts",
    "test:performance": "playwright test tests/e2e/performance.spec.ts",
    "test:uat": "playwright test tests/e2e/uat.spec.ts tests/e2e/complete-flow.spec.ts",
    "test:report": "playwright show-report",
    "test:install-browsers": "playwright install chromium",
    "test:functional": "playwright test tests/e2e/functional.spec.ts tests/e2e/food.spec.ts tests/e2e/exercise.spec.ts tests/e2e/trainer.spec.ts tests/e2e/planner.spec.ts tests/e2e/tracking.spec.ts",
    "test:integration": "playwright test tests/e2e/integration.spec.ts tests/e2e/cloud-sync.spec.ts",
    "test:system": "playwright test tests/e2e/system.spec.ts",
    "test:regression": "playwright test tests/e2e/regression.spec.ts tests/e2e/diwali.spec.ts",
    "test:accessibility": "playwright test tests/e2e/accessibility.spec.ts",
    "test:sanity": "playwright test tests/e2e/sanity.spec.ts",
    "test:frontend": "playwright test tests/e2e/frontend.spec.ts",
    "test:ui": "playwright test tests/e2e/ui.spec.ts tests/e2e/mobile.spec.ts",
    "test:edge": "playwright test tests/e2e/edge-cases.spec.ts tests/e2e/validation.spec.ts",
    "test:database": "playwright test tests/e2e/database.spec.ts",
    "test:journey": "playwright test tests/e2e/journey.spec.ts",
    "test:contracts": "node --test tests/contracts/*.test.mjs",
    "test:release": "npm run test:contracts && playwright test",
    "test:list": "playwright test --list",
    "test:desktop": "playwright test --project=chromium",
    "test:mobile": "playwright test --project=mobile-chrome"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
